# Non-secret, environment-agnostic runtime configuration.
#
# This file is committed on purpose: it is the reviewable half of the runtime
# environment. render-env.sh merges it with, in increasing precedence:
#   * on-chain addresses derived from deployments/solana-<cluster>.json
#   * SSM Parameter Store values Terraform owns (domains, origins, database)
#   * the Secrets Manager runtime secret (provider keys, RPC URL, keypairs)
#
# NEVER put a credential here. Anything secret belongs in the runtime secret;
# see infra/aws/README.md.

# Redis runs on the same host as the services (see docker-compose.prod.yml) and
# is reached over the compose network. It only backs the health checks today.
REDIS_URL=redis://redis:6379

# Selects which deployments/solana-<cluster>.json supplies the program ids, the
# Switchboard program, and the randomness queue. Changing this is a deliberate
# release, not a runtime toggle.
TYCHE_SOLANA_CLUSTER=devnet

# ---------------------------------------------------------------------------
# Turn automation
# ---------------------------------------------------------------------------
TYCHE_TURN_AUTOMATION_ENABLED=true
TYCHE_TURN_AUTOMATION_INTERVAL_MS=10000

# TEST-ONLY manual turn control. render-env.sh refuses to deploy with this
# enabled, and the Caddyfile does not expose the routes either.
TYCHE_TURN_MANUAL_CONTROL_ENABLED=false

# 10000 bps = 100% of the configured turn duration. Lower values compress a
# turn for testing; production must run at full duration.
TYCHE_DEVNET_TURN_DURATION_SCALE_BPS=10000

TYCHE_ELECTION_TOP_VOTED_FINALISTS=3
TYCHE_ELECTION_RANDOM_FINALISTS=7

# Phase-1 proposals only become eligible for election once precompiled, so this
# loop is part of the working game loop rather than an optional extra.
TYCHE_RULE_PRECOMPILE_ENABLED=true
TYCHE_RULE_PRECOMPILE_INTERVAL_MS=15000

# ---------------------------------------------------------------------------
# Settlement and rewards
# ---------------------------------------------------------------------------
# Deliberately off. These loops sign transactions that move funds, and the
# project gates them on reviewed on-chain artifacts (see the comments in
# docker-compose.yml and the settlement plan). Enabling any of them is an
# operator decision recorded in a release, never a default a deploy inherits.
#
# With settlement automation off, turn automation closes turns itself, so the
# game loop still runs.
TYCHE_SETTLEMENT_AUTOMATION_ENABLED=false
TYCHE_SETTLEMENT_AUTOMATION_INTERVAL_MS=30000
TYCHE_SETTLEMENT_MAX_STEPS_PER_TICK=10

TYCHE_TOKEN_REWARD_SETTLEMENT_ENABLED=false
TYCHE_TOKEN_REWARD_SETTLEMENT_INTERVAL_MS=30000
TYCHE_TOKEN_REWARD_MAX_PER_PASS=20

TYCHE_ACTIVE_RULE_REWARD_SETTLEMENT_ENABLED=false
TYCHE_ACTIVE_RULE_REWARD_SETTLEMENT_INTERVAL_MS=30000
TYCHE_ACTIVE_RULE_REWARD_BROADCAST=0

TYCHE_REFERRAL_REWARD_SETTLEMENT_ENABLED=false
TYCHE_REFERRAL_REWARD_SETTLEMENT_INTERVAL_MS=30000

TYCHE_TOKENOMICS_REVENUE_AUTOMATION_ENABLED=false
TYCHE_TOKENOMICS_REVENUE_AUTOMATION_INTERVAL_MS=30000

# Shipped in the production image (infra/docker/Dockerfile.prod), built from
# contracts/solana in the same build as the services.
TYCHE_TOKENOMICS_RUST_CALCULATOR=/usr/local/bin/tokenomics-calculator

# ---------------------------------------------------------------------------
# LLM knobs
# ---------------------------------------------------------------------------
# Provider selection (LLM_BASE_URL, LLM_MODEL, the per-role overrides) and the
# provider keys live in the runtime secret, because they change with the
# operator's provider contract rather than with a code release. render-env.sh
# refuses to deploy if the endpoint and model are missing.
LLM_TIMEOUT_MS=180000
LLM_SEED=7

# Translation before interpret/compile costs an extra call. Leave it off while
# the configured model reads the player's language directly; turn it on if a
# smaller model is routed to the interpret role.
LLM_TRANSLATE_TO_ENGLISH=false

AI_USAGE_SAMPLE_INTERVAL_MS=60000
