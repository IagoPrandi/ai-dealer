# Controlled devnet test profile: settlement is scoped to the active round;
# opening future rounds and every reward worker remain opt-in.
TYCHE_TURN_MANUAL_OPEN_DURATION_SECONDS=1200
TYCHE_DEVNET_TURN_DURATION_SCALE_BPS=139
TYCHE_TURN_AUTOMATION_ENABLED=false
# Round 34 is finalized. Pause its completed scheduler before the isolated
# referral ceremony so it does not consume devnet public-RPC capacity.
TYCHE_SETTLEMENT_AUTOMATION_ENABLED=false
TYCHE_TOKEN_REWARD_SETTLEMENT_ENABLED=false
TYCHE_TOKEN_REWARD_MAX_PER_PASS=2
TYCHE_TOKEN_REWARD_ACTION_ALLOWLIST=
TYCHE_ACTIVE_RULE_REWARD_SETTLEMENT_ENABLED=false
TYCHE_ACTIVE_RULE_REWARD_TURN_ALLOWLIST=
# Enable only for a separately reviewed turn:invitee target. The live `.env`
# may contain a temporary target while a controlled devnet validation runs.
TYCHE_REFERRAL_REWARD_SETTLEMENT_ENABLED=false
TYCHE_REFERRAL_REWARD_SETTLEMENT_INTERVAL_MS=300000
TYCHE_REFERRAL_REWARD_TARGET_ALLOWLIST=
TYCHE_DURABLE_INDEXER_RECONCILIATION_INTERVAL_MS=300000
TYCHE_TURN_MANUAL_CONTROL_ENABLED=true
TYCHE_API_BASE_URL=http://api:3002
TYCHE_TURN_AUTHORITY_KEYPAIR_PATH=/solana-home/.config/tyche/devnet/tyche-deployer-keypair.json
