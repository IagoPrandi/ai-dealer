# Controlled devnet test profile: settlement is scoped to the active round;
# opening future rounds and every reward worker remain opt-in.
IDEALER_TURN_MANUAL_OPEN_DURATION_SECONDS=1200
IDEALER_DEVNET_TURN_DURATION_SCALE_BPS=139
IDEALER_TURN_AUTOMATION_ENABLED=false
# Round 34 is finalized. Pause its completed scheduler before the isolated
# referral ceremony so it does not consume devnet public-RPC capacity.
IDEALER_SETTLEMENT_AUTOMATION_ENABLED=false
IDEALER_TOKEN_REWARD_SETTLEMENT_ENABLED=false
IDEALER_TOKEN_REWARD_MAX_PER_PASS=2
IDEALER_TOKEN_REWARD_ACTION_ALLOWLIST=
IDEALER_ACTIVE_RULE_REWARD_SETTLEMENT_ENABLED=false
IDEALER_ACTIVE_RULE_REWARD_TURN_ALLOWLIST=
IDEALER_REFERRAL_REWARD_SETTLEMENT_ENABLED=true
IDEALER_REFERRAL_REWARD_SETTLEMENT_INTERVAL_MS=300000
IDEALER_REFERRAL_REWARD_TARGET_ALLOWLIST=35:DTR7BM7wgHJQ7dJUnQe7KCkWVPB6Jky4EkHAVSstQakY
IDEALER_DURABLE_INDEXER_RECONCILIATION_INTERVAL_MS=300000
IDEALER_TURN_MANUAL_CONTROL_ENABLED=true
IDEALER_API_BASE_URL=http://api:3002
IDEALER_TURN_AUTHORITY_KEYPAIR_PATH=/solana-home/.config/idealer/devnet/idealer-deployer-keypair.json
