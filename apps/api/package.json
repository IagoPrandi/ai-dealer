{
  "name": "@tyche/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-prompts.mjs",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src scripts --max-warnings=0",
    "stress:rules:set4": "node scripts/rule-preflight-stress-set-4.mjs",
    "stress:rules:set5": "node scripts/rule-preflight-novel-set-5.mjs",
    "stress:rules:set6": "node scripts/rule-preflight-novel-set-6.mjs",
    "stress:rules:set7": "node scripts/rule-preflight-novel-set-7.mjs",
    "stress:rules:set8": "node scripts/rule-preflight-novel-set-8.mjs",
    "stress:rules:set9": "node scripts/rule-preflight-novel-set-9.mjs",
    "stress:rules:set10": "node scripts/rule-preflight-novel-set-10.mjs",
    "stress:rules:set11": "node scripts/rule-preflight-novel-set-11.mjs",
    "stress:rules:set12": "node scripts/rule-preflight-novel-set-12.mjs",
    "test": "node --test --import tsx \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "usage:report": "node --import tsx scripts/rule-usage-report.mts"
  },
  "dependencies": {
    "@tyche/constants": "workspace:*",
    "@tyche/rule-compiler": "workspace:*",
    "@tyche/tokenomics": "workspace:*",
    "pg": "8.21.0",
    "redis": "6.0.0"
  },
  "devDependencies": {
    "@tyche/config": "workspace:*",
    "@types/pg": "8.20.0"
  }
}
