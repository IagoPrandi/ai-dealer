{
  "name": "@tyche/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-prompts.mjs",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src scripts --max-warnings=0",
    "experiment:jev:pipeline:j2": "node --import tsx scripts/jev-pipeline-j2-evaluation.mts",
    "experiment:jev:pipeline:p05": "node --import tsx scripts/jev-pipeline-p05-evaluation.mts",
    "experiment:jev:pipeline:j4": "node --import tsx scripts/jev-pipeline-j4-evaluation.mts",
    "experiment:jev:pipeline:j5": "node --import tsx scripts/jev-pipeline-j5-evaluation.mts",
    "experiment:jev:pipeline:j8": "node --import tsx scripts/jev-pipeline-j8-evaluation.mts",
    "measure:rules": "node --import tsx scripts/jev-pipeline-j8-baseline.mts",
    "measure:artifact-check": "node --import tsx scripts/jev-artifact-check-evaluation.mts",
    "test": "node --test --import tsx \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "usage:report": "node --import tsx scripts/rule-usage-report.mts"
  },
  "dependencies": {
    "@tyche/constants": "workspace:*",
    "@tyche/rule-compiler": "workspace:*",
    "@tyche/tokenomics": "workspace:*",
    "pg": "8.21.0",
    "redis": "6.0.0"
  },
  "devDependencies": {
    "@tyche/config": "workspace:*",
    "@types/pg": "8.20.0"
  }
}
