{
  "name": "@tyche/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "dev:mock": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "dev:https": "next dev --webpack --hostname 0.0.0.0 --port 3000 --experimental-https",
    "dev:tunnel": "cloudflared tunnel --url http://localhost:3000",
    "icons": "node scripts/build-icons.mjs",
    "lint": "eslint src next.config.ts --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx \"src/**/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.44.0",
    "@solana-mobile/wallet-standard-mobile": "0.5.2",
    "@solana-program/memo": "0.10.0",
    "@solana/client": "1.7.0",
    "@solana/kit": "5.5.1",
    "@solana/react-hooks": "1.4.1",
    "@solana/web3.js": "1.98.4",
    "@sqds/multisig": "2.1.4",
    "@tyche/constants": "workspace:*",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tyche/config": "workspace:*",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "dotenv": "16.6.1",
    "sharp": "0.34.5"
  }
}
