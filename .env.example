TOKENOMICS_MULTISIG_PROGRAM_ID=SQDS4ep65T869zMMBKyuUq6aD6EgTu8psMjkvj52pCf
TOKENOMICS_MULTISIG_MEMBER_A=EHHVmFK3FM9qb2eyc8wnEwpHtVH3yW1FGZzrEGn4iSea
TOKENOMICS_MULTISIG_MEMBER_B=EAoZrh8TtZCYtUdKpkuMaNSrConsQoUQvzjZ7cuQGqdW
TOKENOMICS_MULTISIG_MEMBER_C=7E3DMct5umGMA4mSeAr1UcJUFSd5kd444rK39G8GTC9p
TOKENOMICS_MULTISIG_THRESHOLD=2
TOKENOMICS_MULTISIG_TIMELOCK_SECONDS=0
# Finalized devnet Squads v4 rehearsal account. Do not reuse on mainnet.
TOKENOMICS_MULTISIG_ACCOUNT_ADDRESS=DQmcXBdLsQUVsk8UmgnTdnjruRHnAquuFP9wPa87T5RD
TOKENOMICS_MULTISIG_VAULT_INDEX=0
# Derived devnet vault PDA. It has no account or balance until it receives assets.
TOKENOMICS_GOVERNANCE_VAULT_ADDRESS=DB5nz633YioWzEUnLb97ypUra5RUE11SJDFW9ar23KTp
# Required bearer secret for finalized-chain indexer projections into apps/api.
TOKENOMICS_PROJECTION_TOKEN=
# Absolute path to the independently built Rust calculator executable.
TYCHE_TOKENOMICS_RUST_CALCULATOR=
TYCHE_TOKENOMICS_REVENUE_AUTOMATION_ENABLED=false
# Devnet backfill currently starts at the first current-layout turn (32).
TYCHE_TOKENOMICS_FIRST_EPOCH_TURN_ID=32
TYCHE_TOKENOMICS_REVENUE_AUTOMATION_INTERVAL_MS=30000
# Must be the public HTTPS base that serves this API's content-addressed artifacts.
TYCHE_TOKENOMICS_ARTIFACT_BASE_URL=
# 32-byte hex commit/hash identifying the reviewed epoch calculation code.
TYCHE_TOKENOMICS_CALCULATION_CODE_COMMIT=
# Optional only while publisher operations remain manual. If set, the public
# key must exactly match TokenConfig. Never commit the secret value or file.
TYCHE_TOKENOMICS_EPOCH_PUBLISHER_KEYPAIR=
TYCHE_TOKENOMICS_EPOCH_PUBLISHER_KEYPAIR_PATH=
TYCHE_SWITCHBOARD_ON_DEMAND_QUEUE_PDA=DLfvpUBDZaHi2D4nAKxdkNwCVDU7esu5WKHwfHdjbeTs
TYCHE_TURN_AUTOMATION_ENABLED=true
TYCHE_TURN_AUTOMATION_INTERVAL_MS=10000
TYCHE_TURN_AUTHORITY_KEYPAIR_PATH=
TYCHE_TURN_AUTHORITY_KEYPAIR=
# Scales the 24h production turn for devnet: 1500 bps -> 12960s (3.6h) turns;
# 56 bps -> ~8-minute turns for hands-on testing.
TYCHE_DEVNET_TURN_DURATION_SCALE_BPS=10000

# M5.3 settlement scheduler. OFF by default. When enabled the worker drives the
# post-play-window pipeline (election -> draw -> close -> verification ->
# winners/rewards -> claims) and turn automation defers the close to it.
TYCHE_SETTLEMENT_AUTOMATION_ENABLED=false
TYCHE_SETTLEMENT_AUTOMATION_INTERVAL_MS=30000
TYCHE_TOKEN_REWARD_SETTLEMENT_ENABLED=false
TYCHE_TOKEN_REWARD_SETTLEMENT_INTERVAL_MS=30000
TYCHE_TOKEN_REWARD_MAX_PER_PASS=20
# Optional comma-separated action-account allowlist for controlled backfills.
# When set, newly discovered proposal/vote actions are excluded fail-closed.
TYCHE_TOKEN_REWARD_ACTION_ALLOWLIST=
# All JDR settlement loops stay disabled: users claim supported rewards manually.
TYCHE_ACTIVE_RULE_REWARD_SETTLEMENT_ENABLED=false
TYCHE_ACTIVE_RULE_REWARD_SETTLEMENT_INTERVAL_MS=30000
TYCHE_ACTIVE_RULE_REWARD_TURN_ALLOWLIST=
TYCHE_REFERRAL_REWARD_SETTLEMENT_ENABLED=false
TYCHE_REFERRAL_REWARD_SETTLEMENT_INTERVAL_MS=300000
TYCHE_REFERRAL_REWARD_TARGET_ALLOWLIST=
# Manual operator command remains dry-run unless this is set to 1.
TYCHE_ACTIVE_RULE_REWARD_BROADCAST=0
TYCHE_SETTLEMENT_MAX_STEPS_PER_TICK=10
# Where the worker projects settled results (API). Defaults to the local API.
TYCHE_API_BASE_URL=http://localhost:3002
# Finalist-election sizing (PRD §6.12 default policy: 3 top-voted + 7 random).
TYCHE_ELECTION_TOP_VOTED_FINALISTS=3
TYCHE_ELECTION_RANDOM_FINALISTS=7

# Diagnostic ONLY — keep empty/false outside local rule-compiler debugging. Lifts
# the cross-provider consensus gate: no mandatory second opinion, and
# PROVIDER_DISAGREEMENT stops blocking. The divergence is still measured and
# written to the validation log, but the rule is then frozen from a single
# unchecked reading that decides who gets paid.
TYCHE_RULE_COMPILER_CONSENSUS_DISABLED=false

# M5.4/M5.5 devnet real-input seeding helper. Dry-run by default; broadcast sends
# real devnet transactions with deterministic test players and the configured
# devnet authority. Use 17 players for M5.5 when the "at least 1" rule must
# deterministically produce alternative-rule winners for any 6-number draw.
# Keep disabled outside manual devnet validation.
TYCHE_M5_INPUTS_BROADCAST=0
TYCHE_M5_INPUTS_OPEN_TURN=0
TYCHE_M5_INPUTS_PLAYER_COUNT=3
TYCHE_M5_INPUTS_FUND_LAMPORTS=120000000
TYCHE_M5_INPUTS_GUESS_NUMBERS=
TYCHE_M5_RULE_TEXT=Win if at least 1 of your numbers appears in the draw.

PROMETHEUS_PORT=9090
GRAFANA_PORT=3004
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ----------------------------------------------------------------------------
# LLM harness (AI Rule Compiler)
#
# Every role speaks OpenAI-compatible /v1/chat/completions, and the transport
# picks its dialect from the endpoint, so switching backends is configuration:
#
#   OpenRouter -> https://openrouter.ai/api/v1   (key in API_KEY_OPENROUTER)
#   Groq       -> https://api.groq.com/openai/v1 (key in API_KEY_GROQ)
#   Ollama     -> http://localhost:11434/v1      (key "ollama"; adds keep_alive)
#
# The two are NOT interchangeable at the request level: Ollama accepts a
# keep_alive field that Groq rejects with HTTP 400, and each controls the hidden
# reasoning trace with a different parameter. The transport handles both; the
# only thing to get right here is the endpoint/model pairing.
# ----------------------------------------------------------------------------
# local | cloud
LLM_MODE=cloud
# OpenAI-compatible endpoint.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Endpoint reachable from inside a container. For a local Ollama on the host
# this is http://host.docker.internal:11434/v1.
LLM_CONTAINER_BASE_URL=https://openrouter.ai/api/v1
# Default model for every role with no explicit override (interpret, and chat
# when LLM_MODEL_CHAT is empty). Never used by compile/review, pinned below.
# Use a NAMED model. OpenRouter's router slugs (openrouter/free, openrouter/auto)
# pick a different backend per request, which measured 4-10x slower on the real
# prompts and made interpret answer in a different language between runs.
# Groq: qwen/qwen3.8-27b, openai/gpt-oss-20b, openai/gpt-oss-120b.
# Ollama: phi4, llama3.2, gemma2:9b, qwen2.5:14b-instruct-q4_K_M.
LLM_MODEL=qwen/qwen3.8-27b
# Local/self-hosted endpoints only ("ollama" is the accepted dummy). A Groq
# endpoint ignores this and reads API_KEY_GROQ, so that secret has one home.
LLM_API_KEY=ollama
LLM_PRIMARY_PROVIDER=groq
LLM_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_CONTAINER_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_MODEL=qwen/qwen3.8-27b
LLM_PRIMARY_MODEL_DIGEST=
LLM_PRIMARY_MODEL_QUANTIZATION=
LLM_PRIMARY_SERVING_ENGINE=groq
LLM_SECONDARY_PROVIDER=groq
LLM_SECONDARY_BASE_URL=https://api.groq.com/openai/v1
LLM_SECONDARY_CONTAINER_BASE_URL=
LLM_SECONDARY_MODEL=openai/gpt-oss-120b
LLM_SECONDARY_MODEL_DIGEST=
LLM_SECONDARY_MODEL_QUANTIZATION=
LLM_SECONDARY_SERVING_ENGINE=groq
LLM_TERTIARY_PROVIDER=groq
LLM_TERTIARY_BASE_URL=https://api.groq.com/openai/v1
LLM_TERTIARY_CONTAINER_BASE_URL=
LLM_TERTIARY_MODEL=openai/gpt-oss-20b
LLM_TERTIARY_MODEL_DIGEST=
LLM_TERTIARY_MODEL_QUANTIZATION=
LLM_TERTIARY_SERVING_ENGINE=groq
# Artifact-emission role. This model MUST support decoder-enforced JSON Schema;
# do not point it at an Ollama `:cloud` model that ignores structured outputs.
# On Groq only qwen/qwen3.8-27b, openai/gpt-oss-20b and openai/gpt-oss-120b
# enforce the schema while decoding — every other Groq model validates
# best-effort, which PRD 7.3.1 does not accept for the AST.
# Keep this explicit when LLM_MODEL is optimized for chat/interpretation.
# The artifact-emitting role needs constrained decoding on THIS compiler's
# schema (8288 bytes, 43 recursive $refs at depth 10), which is much narrower
# than "supports structured outputs" and is NOT a property of the model alone:
#   Groq        cannot build the grammar at all — hangs ~33 s then drops the
#               connection, on every model tried.
#   OpenRouter  depends on the backend, so requests carry
#               `provider: {require_parameters: true}`. openai/gpt-oss-120b and
#               mistralai/mistral-small-24b emit valid ASTs; the Nvidia backend
#               behind nvidia/nemotron-3-super answers 502 every time.
#   Ollama      gemma4:latest works (~128 s on CPU); gemma3:4b is too small.
# An OpenRouter ROUTER slug (openrouter/free, openrouter/auto) is rejected here:
# it names no backend, so it can attest to no decoder. Setting one fails closed
# with RULE_AGENT_SCHEMA_UNSUPPORTED. Measured on openrouter/free against the
# real candidate schema: 0 of 4 calls produced a parseable candidate, one of
# them HTTP 404 "No endpoints found that can handle the requested parameters".
# `LLM_COMPILE_BASE_URL` gives this role its own endpoint; empty follows LLM_BASE_URL.
LLM_COMPILE_BASE_URL=
LLM_COMPILE_MAX_OUTPUT_TOKENS=16384
LLM_MODEL_COMPILE=openai/gpt-oss-120b
# Independent source-to-AST reviewer. Prefer a different schema-capable model;
# when blank, the compile model is reused with a separate reviewer prompt and
# decoding pass. The reviewer never receives the generated draft.
LLM_MODEL_REVIEW=mistralai/mistral-small-24b-instruct-2501
LLM_MODEL_INTERPRET=
# Conversational chat step only (player questions), never the rule pipeline.
# This carries the largest prompt in the system and a player waits on it, so it
# wants the fastest model that honours the JSON and language contracts.
LLM_MODEL_CHAT=openai/gpt-oss-120b
# How much the chat step may think, and therefore how much reasoning the player
# is shown in the chat: low | full | off. `low` keeps the answer fast while still
# producing a trace worth reading; `off` suppresses it and the reasoning block
# then does not render. The rule pipeline always suppresses its trace.
LLM_CHAT_REASONING=low
# Rule agent request timeout in ms; the runtime enforces a 300000 ms minimum.
LLM_TIMEOUT_MS=300000
# Fixed seed for deterministic rule compilation (temperature 0).
LLM_SEED=7
# Output token budget per rule agent call; the runtime enforces a 1024 minimum.
# A hosted tier can cap this from its side: Groq refuses a request outright when
# max_tokens exceeds the tier's output-tokens-per-minute allowance (its free tier
# allows 1000, i.e. max_tokens <= 900 — below the floor, so the rule pipeline on
# Groq needs the Dev tier).
# Reasoning models spend most of this on a hidden trace before the JSON answer,
# so a small value truncates the response and the rule fails to compile.
LLM_MAX_OUTPUT_TOKENS=16384
# Guardrail model; empty disables the guard. Two protocols are supported and the
# dialect follows the model id:
#   openai/gpt-oss-safeguard-20b -> policy-driven JSON classifier (OpenAI-compatible)
#   granite4.1-guardian:8b       -> Granite <score>yes|no</score> (Ollama native)
LLM_GUARDIAN_MODEL=openai/gpt-oss-safeguard-20b
# The chat step may run on its OWN endpoint, not just its own model. Its prompt
# carries the whole product context (~7.8k input tokens), so it is the first
# thing a hosted per-minute input allowance refuses while the smaller rule and
# guardrail prompts still fit. Groq's on-demand tier caps input at 7000 tokens
# per minute and rejects this prompt outright, so on that tier set:
#   LLM_CHAT_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL_CHAT=gpt-oss:20b   (or any local chat model)
#   LLM_CHAT_MAX_OUTPUT_TOKENS=16384
# and the rule pipeline stays on Groq. Empty means chat follows LLM_BASE_URL.
# The budget travels with the endpoint too: Groq caps it from above, while a
# small local thinking model needs a large one to finish its trace AND the JSON.
# Empty means chat uses LLM_MAX_OUTPUT_TOKENS.
LLM_CHAT_BASE_URL=
LLM_CHAT_MAX_OUTPUT_TOKENS=
# The independent reviewer normally shares the compile endpoint and budget, and
# only its model differs (LLM_MODEL_REVIEW). These move or bound it on its own.
# Empty means it follows the compile role.
#
# The review is the one step whose failure is not fatal — a missing second
# opinion is reported as SECOND_OPINION_UNAVAILABLE — so capping its output
# budget costs nothing and bounds a model that runs away. A successful review is
# a few hundred output tokens; anything near the ceiling is a runaway, not work.
LLM_REVIEW_BASE_URL=
LLM_REVIEW_MAX_OUTPUT_TOKENS=
# The guardrail is an INDEPENDENT check and may run on its own endpoint and key.
# Empty means it follows LLM_BASE_URL / LLM_API_KEY.
LLM_GUARDIAN_BASE_URL=
LLM_GUARDIAN_API_KEY=
# Guardian request timeout in ms.
LLM_GUARDIAN_TIMEOUT_MS=120000
# Stronger model retried when the primary produces an invalid/drifted rule.
# The GPU profile uses gpt-oss-120b; set this empty on CPU-only hosts so Ollama
# does not keep a second large model resident.
LLM_ESCALATION_MODEL=openai/gpt-oss-120b
# Translate rules to English before interpret/compile.
# Set false for capable multilingual models (gemma4:latest+) to save a call.
LLM_TRANSLATE_TO_ENGLISH=false
# --- Measured AI resource accounting (apps/api/src/usage.ts) -----------------
# Every pipeline run records the tokens, cost, CPU and RAM it actually spent, and
# the operator console reports it under `measuredResourceUsage`. Cost is resolved
# in this order, and an unknown price is reported as unknown, never as zero:
#   1. the provider's own per-call cost, when it reports one;
#   2. LLM_PRICE_TABLE_JSON below;
#   3. LLM_ESTIMATED_COST_PER_1K_TOKENS_USD, a single flat rate for everything.
#
# OpenRouter reports its own cost (the API asks for it with `usage.include`), so
# roles on OpenRouter need no price here. Groq and a local Ollama do NOT report
# cost, so any role pointed at them stays unpriced until it is listed below —
# `coverage.runsWithUnpricedCalls` on the console says when that is happening.
# Prices are USD per MILLION tokens:
# LLM_PRICE_TABLE_JSON={"openai/gpt-oss-safeguard-20b":{"inputPerMillionUsd":0.075,"outputPerMillionUsd":0.3}}
LLM_PRICE_TABLE_JSON=
# Last-resort flat rate, USD per THOUSAND tokens, applied to any call the two
# sources above cannot price. Empty or 0 leaves those calls unpriced.
LLM_ESTIMATED_COST_PER_1K_TOKENS_USD=
# How often the RSS/CPU sampler observes an open run, in ms (minimum 50).
AI_USAGE_SAMPLE_INTERVAL_MS=250
# Set to `off` to stop asking OpenRouter for the per-call cost. Token accounting
# is unaffected; only the provider-reported cost is lost.
LLM_USAGE_ACCOUNTING=
# Cloud provider keys for fallback/escalation (JSON or csv).
LLM_PROVIDER_KEYS=
# Hosted-provider keys, read by ENDPOINT: any role pointed at api.groq.com uses
# API_KEY_GROQ and any role pointed at openrouter.ai uses API_KEY_OPENROUTER, so
# each secret has one home and a role moved between endpoints takes the right
# credential with it. A hosted endpoint configured without its key is a hard
# configuration error, never an unauthenticated attempt.
API_KEY_GROQ=
API_KEY_OPENROUTER=
CONFIDENCE_THRESHOLD=0.85
RULE_MAX_TOKENS=1000

# Semantic dedup embeddings (Section 6.15). Not yet read by any code, and Groq
# serves no embeddings API — this stays on a local Ollama when it is implemented.
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_BASE_URL=http://localhost:11434/v1
EMBEDDINGS_CONTAINER_BASE_URL=http://host.docker.internal:11434/v1

# Local inference container (tyche-llm); used only when LLM_MODE=local
LLM_PORT=11434
