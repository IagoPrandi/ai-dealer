COMPOSE_PROJECT_NAME=idealer

POSTGRES_DB=idealer_dev
POSTGRES_USER=idealer
POSTGRES_PASSWORD=idealer_dev_password
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=3002
WORKER_PORT=3003
WEB_PORT=3000
ADMIN_PORT=3001

NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_WS_URL=wss://api.devnet.solana.com
NEXT_PUBLIC_IDEALER_PROGRAM_ID=6TQo79fA3agZYz7mTiCTnBVfDR9HvVR5KjdHgX3cRaA4
NEXT_PUBLIC_IDEALER_ACTIVE_TURN_ID=1
NEXT_PUBLIC_IDEALER_API_URL=http://localhost:3002

IDEALER_SOLANA_RPC_URL=https://api.devnet.solana.com
IDEALER_PROGRAM_ID=6TQo79fA3agZYz7mTiCTnBVfDR9HvVR5KjdHgX3cRaA4
IDEALER_TURN_AUTOMATION_ENABLED=true
IDEALER_TURN_AUTOMATION_INTERVAL_MS=10000
IDEALER_TURN_AUTHORITY_KEYPAIR_PATH=
IDEALER_TURN_AUTHORITY_KEYPAIR=
IDEALER_DEVNET_TURN_DURATION_SCALE_BPS=1500

PROMETHEUS_PORT=9090
GRAFANA_PORT=3004
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ----------------------------------------------------------------------------
# LLM harness (AI Rule Compiler)
# Local/self-hosted models (Phi, Llama, Gemma, Qwen) are reached through an
# OpenAI-compatible endpoint. Cloud providers remain available for fallback.
# ----------------------------------------------------------------------------
LLM_MODE=local                          # local | cloud
LLM_BASE_URL=http://localhost:11434/v1  # OpenAI-compatible endpoint (Ollama default); empty for pure cloud
LLM_CONTAINER_BASE_URL=http://host.docker.internal:11434/v1 # Docker service -> host Ollama endpoint
LLM_MODEL=gemma4:latest # e.g. phi4, llama3.2, gemma2:9b, qwen2.5:14b-instruct-q4_K_M
LLM_API_KEY=ollama                      # dummy value for local endpoints; real key for cloud
LLM_PRIMARY_PROVIDER=local-openai-compatible
LLM_PRIMARY_BASE_URL=http://localhost:11434/v1
LLM_PRIMARY_CONTAINER_BASE_URL=http://host.docker.internal:11434/v1
LLM_PRIMARY_MODEL=gemma4:latest
LLM_PRIMARY_MODEL_DIGEST=
LLM_PRIMARY_MODEL_QUANTIZATION=
LLM_PRIMARY_SERVING_ENGINE=ollama
LLM_SECONDARY_PROVIDER=openai
LLM_SECONDARY_BASE_URL=
LLM_SECONDARY_CONTAINER_BASE_URL=
LLM_SECONDARY_MODEL=gpt-4.1-mini
LLM_SECONDARY_MODEL_DIGEST=
LLM_SECONDARY_MODEL_QUANTIZATION=
LLM_SECONDARY_SERVING_ENGINE=openai
LLM_TERTIARY_PROVIDER=anthropic
LLM_TERTIARY_BASE_URL=
LLM_TERTIARY_CONTAINER_BASE_URL=
LLM_TERTIARY_MODEL=claude-3-5-sonnet
LLM_TERTIARY_MODEL_DIGEST=
LLM_TERTIARY_MODEL_QUANTIZATION=
LLM_TERTIARY_SERVING_ENGINE=anthropic
LLM_MODEL_COMPILE=
LLM_MODEL_INTERPRET=
LLM_TIMEOUT_MS=180000                    # rule agent request timeout (ms); raise for slow local thinking models
LLM_SEED=7                               # fixed seed for deterministic rule compilation (temperature 0)
LLM_GUARDIAN_MODEL=granite4.1-guardian:8b # IBM Granite Guardian guardrail model (jailbreak + groundedness checks); empty disables the guard
LLM_GUARDIAN_TIMEOUT_MS=120000           # guardian request timeout (ms)
LLM_ESCALATION_MODEL=gemma4:e2b          # stronger model retried when the primary produces an invalid/drifted rule (gemma4:e2b is lighter for constrained hosts; gemma4:latest is stronger but needs more RAM); empty disables escalation
LLM_TRANSLATE_TO_ENGLISH=true            # translate the rule to English before interpret/compile (removes ambiguity for small models); set false for capable multilingual models (gemma4:latest+) to save a call
LLM_PROVIDER_KEYS=                       # cloud provider keys for fallback/escalation (JSON or csv)
CONFIDENCE_THRESHOLD=0.85
RULE_MAX_TOKENS=1000

# Semantic dedup embeddings (Section 6.15)
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_BASE_URL=http://localhost:11434/v1
EMBEDDINGS_CONTAINER_BASE_URL=http://host.docker.internal:11434/v1

# Local inference container (idealer-llm); used only when LLM_MODE=local
LLM_PORT=11434
