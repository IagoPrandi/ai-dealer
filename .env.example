COMPOSE_PROJECT_NAME=tyche

POSTGRES_DB=tyche_dev
POSTGRES_USER=tyche
POSTGRES_PASSWORD=tyche_dev_password
POSTGRES_PORT=5432

REDIS_PORT=6379

# Native API and worker processes connect to the Dockerized data stores through
# the host ports above. Copy these values to .env for local development.
DATABASE_URL=postgresql://tyche:tyche_dev_password@localhost:5432/tyche_dev
REDIS_URL=redis://localhost:6379

API_PORT=3002
WORKER_PORT=3003
WEB_PORT=3000
ADMIN_PORT=3001

# Required for a production web deployment. Local development defaults to the
# loopback services only when VERCEL_ENV is not "production".
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TYCHE_API_PROXY_TARGET=http://localhost:3002
TYCHE_WORKER_PROXY_TARGET=http://localhost:3003

# Browser origins allowed to call the API and the worker cross-origin. Both are
# empty locally because private and loopback origins are always accepted
# (LOCAL_WEB_ORIGIN_PATTERN in apps/api/src/index.ts and apps/worker/src/index.ts).
# In production they are written by Terraform into SSM Parameter Store from
# var.web_origins; see infra/aws/README.md. Comma separated.
WEB_ORIGIN=
TYCHE_WORKER_CORS_ORIGINS=

# Comma, semicolon, or whitespace separated Solana wallet addresses allowed to sign into the restricted AI operations console.
OPERATOR_AI_CONSOLE_AUTHORIZED_WALLETS=

# Required by the DApp. WebSocket traffic is derived from this same provider URL.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_TYCHE_PROGRAM_ID=ExW6LBU6XWsP53cvbtV1N2KFYMaudCtrenimHNWBBENd
NEXT_PUBLIC_TOKENOMICS_CORE_PROGRAM_ID=BRK6G8Sep66LFREp2nGMLiganfw2nbWe1f8zeAdoP1Fm
# Token display identity confirmed by the owner. Devnet may intentionally keep
# the URI empty; mainnet still requires reviewed, durable HTTPS metadata.
NEXT_PUBLIC_TYCHE_TOKEN_NAME=JUSDEALER
NEXT_PUBLIC_TYCHE_TOKEN_SYMBOL=JDR
NEXT_PUBLIC_TYCHE_TOKEN_MINT=FssXNhB2mUSjavX7jsXLuZevfGnJ5zn98nNNUbrY16rr
# Optional only for the pinned Devnet Tokenomics Core build. Metadata update
# authority is Devnet Squads vault 0. A separate mainnet build must fail closed
# until this contains an approved durable HTTPS JSON URI and mainnet governance
# has been decided.
NEXT_PUBLIC_TYCHE_TOKEN_METADATA_URI=
NEXT_PUBLIC_TYCHE_ACTIVE_TURN_ID=1
# Same-origin proxy prefix (rewritten to the API by apps/web/next.config.ts).
# Works from any origin the browser loads — localhost, LAN IP, or an HTTPS
# tunnel used to install the PWA on a phone — without mixed-content or CORS.
# Override with an absolute URL only if the API is served elsewhere.
NEXT_PUBLIC_TYCHE_API_URL=/__api

# Same-origin proxy prefix (rewritten to the worker by apps/web/next.config.ts).
# Keep this aligned with NEXT_PUBLIC_TYCHE_API_URL so live turn polling works
# from localhost, LAN IPs, and HTTPS tunnels without mixed-content or CORS.
NEXT_PUBLIC_TYCHE_WORKER_URL=/__worker

TYCHE_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
TYCHE_PROGRAM_ID=ExW6LBU6XWsP53cvbtV1N2KFYMaudCtrenimHNWBBENd
TOKENOMICS_CORE_PROGRAM_ID=BRK6G8Sep66LFREp2nGMLiganfw2nbWe1f8zeAdoP1Fm
